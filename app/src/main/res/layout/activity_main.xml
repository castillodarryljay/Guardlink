<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ios_mesh_gradient"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Bar: Apple iOS Translucent Header -->
            <RelativeLayout
                android:id="@+id/top_bar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:paddingTop="8dp">

                <!-- Left: Logo & Brand Badge -->
                <LinearLayout
                    android:id="@+id/brand_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_brand_logo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_ios_glass_pill"
                        android:padding="9dp"
                        android:src="@android:drawable/ic_lock_lock"
                        app:tint="@color/primary_accent"
                        android:contentDescription="GuardLink Shield" />

                    <LinearLayout
                        android:id="@+id/brand_text_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_brand_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTROL CENTER"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.14" />

                        <TextView
                            android:id="@+id/tv_brand_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GUARDLINK"
                            android:textColor="@color/text_primary"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right: Status Pill & Admin Chip -->
                <LinearLayout
                    android:id="@+id/top_bar_right_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <!-- Status Pill (emerald pulse dot + ONLINE / SYNCED) -->
                    <LinearLayout
                        android:id="@+id/pill_status_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ios_glass_pill_emerald"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp">

                        <View
                            android:id="@+id/view_status_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_dot_emerald" />

                        <TextView
                            android:id="@+id/tv_status_pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="ONLINE / SYNCED"
                            android:textColor="@color/success_telemetry"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />
                    </LinearLayout>

                    <!-- Admin Chip in frosted pill -->
                    <TextView
                        android:id="@+id/tv_admin_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/bg_ios_glass_pill"
                        android:paddingStart="9dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="3dp"
                        android:text="DODONG (Admin)"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Quick Actions: 2x2 Translucent Liquid Glass Grid -->
            <TextView
                android:id="@+id/tv_quick_actions_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="QUICK ACTIONS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <GridLayout
                android:id="@+id/grid_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:layout_marginBottom="24dp">

                <!-- Action 1: Lockdown (Destructive Ruby Frosted Glass with Specular Edge) -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/card_action_lockdown"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_ios_glass_card_destructive"
                    app:blurOverlayColor="@color/glass_overlay_destructive"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iv_action_lockdown_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@android:drawable/ic_lock_power_off"
                            app:tint="@color/accent_destructive"
                            android:contentDescription="Lockdown Action" />

                        <TextView
                            android:id="@+id/tv_action_lockdown_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Lockdown"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_action_lockdown_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Block screen immediately"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <!-- Action 2: Pair Device (Translucent Liquid Glass Surface) -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/card_action_pair"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_ios_glass_card"
                    app:blurOverlayColor="@color/glass_overlay_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iv_action_pair_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@android:drawable/ic_menu_add"
                            app:tint="@color/primary_accent"
                            android:contentDescription="Pair Device Action" />

                        <TextView
                            android:id="@+id/tv_action_pair_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Pair Device"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_action_pair_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Generate 6-digit code"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <!-- Action 3: Screen Sharing (Translucent Liquid Glass Surface) -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/card_action_screen_share"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_ios_glass_card"
                    app:blurOverlayColor="@color/glass_overlay_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iv_action_screen_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@android:drawable/ic_menu_slideshow"
                            app:tint="@color/primary_accent"
                            android:contentDescription="Screen Sharing Action" />

                        <TextView
                            android:id="@+id/tv_action_screen_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Screen Sharing"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_action_screen_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Broadcast admin screen"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>

                <!-- Action 4: Broadcast (Translucent Liquid Glass Surface) -->
                <eightbitlab.com.blurview.BlurView
                    android:id="@+id/card_action_broadcast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_ios_glass_card"
                    app:blurOverlayColor="@color/glass_overlay_color"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/iv_action_broadcast_icon"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@android:drawable/ic_btn_speak_now"
                            app:tint="@color/primary_accent"
                            android:contentDescription="Broadcast Action" />

                        <TextView
                            android:id="@+id/tv_action_broadcast_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Broadcast"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_action_broadcast_sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Intercom voice alert"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </eightbitlab.com.blurview.BlurView>
            </GridLayout>

            <!-- Discovered Devices Header -->
            <RelativeLayout
                android:id="@+id/devices_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_discovered_devices_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="DISCOVERED DEVICES"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <LinearLayout
                    android:id="@+id/devices_header_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_refresh_devices"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_rotate"
                        app:tint="@color/primary_accent"
                        android:contentDescription="Refresh Devices" />

                    <TextView
                        android:id="@+id/tv_online_devices_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ios_glass_pill_emerald"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="ONLINE"
                        android:textColor="@color/success_telemetry"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Discovered Devices RecyclerView / List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_discovered_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_device" />

            <!-- Empty State Container: Frosted Glass Panel -->
            <eightbitlab.com.blurview.BlurView
                android:id="@+id/empty_state_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ios_glass_card"
                app:blurOverlayColor="@color/glass_overlay_color"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:id="@+id/iv_empty_devices"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/text_secondary"
                        android:contentDescription="Empty state icon" />

                    <TextView
                        android:id="@+id/tv_empty_devices_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No GuardLink devices connected"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_empty_devices_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tap 'Pair Device' above to generate a 6-digit sync code."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </eightbitlab.com.blurview.BlurView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
